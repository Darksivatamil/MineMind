# MINEMIND-DEEP configuration
# Copy this file to `.env` and fill in your values. Never commit a real key.

# ---------- Minecraft server ----------
MC_HOST=localhost
MC_PORT=3344
MC_VERSION=1.21.11
MC_USERNAME=AGNES
MC_AUTH=offline
# Must match your exact Minecraft username, or AGNES ignores your chat.
OWNER=Player

# ---------- AI model (pick ONE; order below = preference) ----------

# OpenRouter (works with hundreds of models, many free)
# Free models are rate-limited upstream — that's OpenRouter, not your setup.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Google Gemini (needs a real key from https://aistudio.google.com/apikey,
# which starts with "AIza...")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Optional extra fallbacks (used automatically if the ones above fail)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
NVIDIA_API_KEY=

# Local model via Ollama (set to 1 to enable)
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# ---------- Logging ----------
# error | warn | info | debug
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Phone / Termux install notes
# ---------------------------------------------------------------------------
# If the app says "missing dependencies", run:
#     npm install
# If that fails or hangs (slow phone network), run:
#     npm install --fetch-timeout=600000
#
# `dotenv` is OPTIONAL — the app parses .env itself if dotenv is absent.
